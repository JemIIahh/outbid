# Copy to .env (git-ignored). Nothing here is needed to try the demo on the practice chain.

# Real agents. Without it the demo runs stand-in agents that return placeholder text.
ANTHROPIC_API_KEY=

# Where the page is served. Default 8787.
PORT=8787

# 1 adds two cheating test sellers (Sly, Fakir) so you can watch bad bids thrown out.
OUTBID_ADVERSARY=1

# ---- Celo mainnet (REAL MONEY). Leave all of these unset unless you mean it. ----
# OUTBID_LIVE=1
# OUTBID_CONFIRM_SPEND=yes
# OUTBID_OWNER_KEY=0x...        # holds the USDT, owns the spending policy
# OUTBID_BUYER_KEY=0x...        # the agent that pays under the policy (must differ from the owner)
# OUTBID_SELLER_MNEMONIC="..."  # a fresh phrase that derives the seller keys; never reuse a phrase you use elsewhere
# (pnpm keys writes the three secrets above for you. Then: pnpm funding, then pnpm proof.)
# OUTBID_RPC_URL=https://forno.celo.org
# OUTBID_PROOF_AGAIN=1          # only to replace an existing web/fixtures/proof.json (spends again)
